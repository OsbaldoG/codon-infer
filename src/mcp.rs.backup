//! MCP Server for codon-infer
//!
//! Exposes `generate_protein` as a standardized tool for autonomous AI agents
//! (Claude, Gemini, Codex, etc.) via the Model Context Protocol over stdio.

use crate::*;
use serde::{Deserialize, Serialize};
use std::io::{self, BufRead, BufReader, Write};

/// JSON-RPC 2.0 Request
#[derive(Debug, Deserialize)]
#[serde(untagged)]
enum JsonRpcRequest {
    Call {
        jsonrpc: String,
        id: serde_json::Value,
        method: String,
        params: serde_json::Value,
    },
    Notification {
        jsonrpc: String,
        method: String,
        params: serde_json::Value,
    },
}

/// JSON-RPC 2.0 Response
#[derive(Debug, Serialize)]
#[serde(untagged)]
enum JsonRpcResponse {
    Success {
        jsonrpc: String,
        id: serde_json::Value,
        result: serde_json::Value,
    },
    Error {
        jsonrpc: String,
        id: serde_json::Value,
        error: JsonRpcError,
    },
}

#[derive(Debug, Serialize)]
struct JsonRpcError {
    code: i32,
    message: String,
    #[serde(skip_serializing_if = "Option::is_none")]
    data: Option<serde_json::Value>,
}

/// MCP Tool definition
#[derive(Debug, Serialize)]
struct Tool {
    name: String,
    description: String,
    input_schema: serde_json::Value,
}

/// MCP Initialize response
#[derive(Debug, Serialize)]
struct InitializeResult {
    protocol_version: String,
    capabilities: serde_json::Value,
    server_info: ServerInfo,
}

#[derive(Debug, Serialize)]
struct ServerInfo {
    name: String,
    version: String,
}

/// Parameters for generate_protein tool
#[derive(Debug, Deserialize)]
struct GenerateProteinParams {
    /// Initial amino acid sequence seed / prompt (e.g., "MCMPCFTTDHQMARKCDD")
    prompt: String,
    /// Sampling temperature (0.0 = greedy, higher = more diverse)
    #[serde(default = "default_temperature")]
    temperature: f32,
    /// Maximum tokens to generate
    #[serde(default = "default_max_tokens")]
    max_tokens: usize,
    /// Optional seed for reproducibility
    #[serde(default)]
    seed: Option<u64>,
}

fn default_temperature() -> f32 {
    0.7
}

fn default_max_tokens() -> usize {
    200
}

/// Result of generate_protein tool
#[derive(Debug, Serialize)]
struct GenerateProteinResult {
    /// Full generated sequence (prompt + continuation)
    sequence: String,
    /// Only the de novo generated continuation
    generated: String,
    /// Number of tokens generated
    tokens_generated: usize,
    /// Pre-fill latency in milliseconds
    prefill_ms: u64,
    /// Generation latency in milliseconds
    generation_ms: u64,
    /// Throughput in tokens/second
    throughput: f32,
}

/// Run the MCP server over stdio
pub fn run_mcp_server(config: &EsmConfig, weights: &EsmWeights) -> io::Result<()> {
    let stdin = io::stdin();
    let mut reader = BufReader::new(stdin.lock());
    let mut stdout = io::stdout();
    let mut line = String::new();

    // Server initialization - respond to initialize request
    loop {
        line.clear();
        let bytes = reader.read_line(&mut line)?;
        if bytes == 0 {
            return Ok(()); // EOF
        }

        let request: JsonRpcRequest = match serde_json::from_str(line.trim()) {
            Ok(req) => req,
            Err(e) => {
                eprintln!("Parse error: {}", e);
                continue;
            }
        };

        match request {
            JsonRpcRequest::Call { id, method, params, .. } => {
                let response = match method.as_str() {
                    "initialize" => handle_initialize(id),
                    "tools/list" => handle_tools_list(id),
                    "tools/call" => handle_tool_call(id, params, config, weights),
                    _ => JsonRpcResponse::Error {
                        jsonrpc: "2.0".to_string(),
                        id,
                        error: JsonRpcError {
                            code: -32601,
                            message: format!("Method not found: {}", method),
                            data: None,
                        },
                    },
                };
                write_response(&mut stdout, &response)?;
            }
            JsonRpcRequest::Notification { method, .. } => {
                if method == "initialized" {
                    // Client acknowledged initialization
                }
            }
        }
    }
}

fn handle_initialize(id: serde_json::Value) -> JsonRpcResponse {
    JsonRpcResponse::Success {
        jsonrpc: "2.0".to_string(),
        id,
        result: serde_json::to_value(InitializeResult {
            protocol_version: "2024-11-05".to_string(),
            capabilities: serde_json::json!({
                "tools": {}
            }),
            server_info: ServerInfo {
                name: "codon-infer".to_string(),
                version: env!("CARGO_PKG_VERSION").to_string(),
            },
        })
        .unwrap(),
    }
}

fn handle_tools_list(id: serde_json::Value) -> JsonRpcResponse {
    let tools = vec![Tool {
        name: "generate_protein".to_string(),
        description: "Generate protein sequences using ESM-2 8M parameter model. \
            Provide a seed sequence (e.g., 'MCMPCFTTDHQMARKCDD') and get autoregressive \
            continuation with biologically-constrained sampling (canonical amino acids only)."
            .to_string(),
        input_schema: serde_json::json!({
            "type": "object",
            "properties": {
                "prompt": {
                    "type": "string",
                    "description": "Initial amino acid sequence seed (e.g., 'MCMPCFTTDHQMARKCDD')"
                },
                "temperature": {
                    "type": "number",
                    "default": 0.7,
                    "description": "Sampling temperature (0.0 = greedy, higher = more diverse)"
                },
                "max_tokens": {
                    "type": "integer",
                    "default": 200,
                    "description": "Maximum tokens to generate"
                },
                "seed": {
                    "type": ["integer", "null"],
                    "description": "Optional seed for reproducibility"
                }
            },
            "required": ["prompt"]
        }),
    }];

    JsonRpcResponse::Success {
        jsonrpc: "2.0".to_string(),
        id,
        result: serde_json::json!({ "tools": tools }),
    }
}

fn handle_tool_call(
    id: serde_json::Value,
    params: serde_json::Value,
    config: &EsmConfig,
    weights: &EsmWeights,
) -> JsonRpcResponse {
    // MCP tools/call params: { "name": "...", "arguments": {...} }
    let arguments = params.get("arguments").cloned().unwrap_or(serde_json::Value::Null);
    let tool_params: GenerateProteinParams = match serde_json::from_value(arguments) {
        Ok(p) => p,
        Err(e) => {
            return JsonRpcResponse::Error {
                jsonrpc: "2.0".to_string(),
                id,
                error: JsonRpcError {
                    code: -32602,
                    message: format!("Invalid parameters: {}", e),
                    data: None,
                },
            };
        }
    };

    let gen_config = GenerationConfig {
        temperature: tool_params.temperature,
        max_tokens: tool_params.max_tokens.min(config.max_seq_len),
        seed: tool_params.seed,
        stop_at_eos: true,
    };

    let result = generate(&tool_params.prompt, config, weights, gen_config);

    let tool_result = GenerateProteinResult {
        sequence: format!("{}{}", tool_params.prompt, result.sequence),
        generated: result.sequence,
        tokens_generated: result.tokens_generated,
        prefill_ms: result.prefill_latency.as_millis() as u64,
        generation_ms: result.generation_latency.as_millis() as u64,
        throughput: if result.generation_latency.as_secs_f32() > 0.0 {
            result.tokens_generated as f32 / result.generation_latency.as_secs_f32()
        } else {
            0.0
        },
    };

    JsonRpcResponse::Success {
        jsonrpc: "2.0".to_string(),
        id,
        result: serde_json::json!({
            "content": [{
                "type": "text",
                "text": serde_json::to_string_pretty(&tool_result).unwrap()
            }]
        }),
    }
}

fn write_response<W: Write>(writer: &mut W, response: &JsonRpcResponse) -> io::Result<()> {
    let json = serde_json::to_string(response)?;
    writeln!(writer, "{}", json)?;
    writer.flush()
}